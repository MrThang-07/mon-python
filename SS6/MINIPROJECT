# CAU 3 
cout = 0
hople = 0 
thunghang = int(input("Nhập số thùng :"))
for i in range(1,thunghang + 1):
    print(f"Thêm số lượng thùng hàng {i} : ")
    soluong = int(input("Nhập so luong : "))
    if soluong < 0 :
        print("Số lượng không hợp lệ, bỏ qua thùng này!")
    elif soluong == 0 :
        hople += 1
        continue 
    else :
        hople += 1
        cout = cout + soluong 
print("Tổng số thùng hàng hợp lệ :",hople)
print("Tổng số lượng sản phẩm thu được : ",cout)



    
