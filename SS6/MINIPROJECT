dongia = int(input("Nhập đơn giá của một sản phầm: "))
soluong = int(input("Nhập số lượng mua :"))
tongtien = dongia * soluong 
if tongtien >= 1000000 :
    tongtien = (tongtien - tongtien * 0.1 )
else :
    tongtien = (tongtien - tongtien * 0)
print("Số tiền khách phải thanh toán là : ",tongtien)

